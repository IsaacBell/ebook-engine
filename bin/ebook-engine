#!/usr/bin/env bash
# GridLab Ebook Engine — repo-local CLI wrapper.
# Sets up PYTHONPATH so the ebook_engine package can be imported without
# installing the package from PyPI.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

# Repo-local imports: the ebook_engine package plus pdf_lib for markdown builds.
EXTRA_PATHS="${APP_ROOT}:${REPO_ROOT}/content/journal/docs"
export PYTHONPATH="${EXTRA_PATHS}${PYTHONPATH:+:${PYTHONPATH}}"

exec python3 -m ebook_engine.cli "$@"
